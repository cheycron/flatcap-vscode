  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "comment keyword",
        "comment storage",
        "comment variable",
        "comment entity",
        "comment punctuation",
        "comment markup"
      ],
      "settings": {
        "foreground": "#536273"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.wordlike",
        "keyword.operator.logical.python",
        "keyword.operator.delete",
        "keyword.operator.typeof",
        "keyword.operator.instanceof",
        "keyword.operator.sizeof",
        "variable.language",
        "entity.name.tag",
        "entity.name.section",
        "keyword.other.definition.ini"
      ],
      "settings": {
        "foreground": "#285D85"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#28313B"
      }
    },
    {
      "name": "Punctuation: separators and accessors",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "punctuation.definition.tag",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#465463"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "storage.type.string",
        "markup.inline.raw",
        "markup.raw.inline",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#32664D"
      }
    },
    {
      "name": "Interpolated code",
      "scope": [
        "meta.template.expression",
        "meta.interpolation",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#28313B"
      }
    },
    {
      "name": "Numbers, literals and constants",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.character.escape",
        "constant.other.placeholder",
        "constant.other.color",
        "support.constant",
        "variable.other.enummember",
        "keyword.other.unit",
        "string.regexp constant.character.escape"
      ],
      "settings": {
        "foreground": "#68598C"
      }
    },
    {
      "name": "CSS values stay neutral",
      "scope": [
        "support.constant.property-value",
        "support.constant.font-name",
        "support.constant.media",
        "support.constant.vendored.property-value"
      ],
      "settings": {
        "foreground": "#28313B"
      }
    },
    {
      "name": "Functions, methods, macros, decorators",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call.generic",
        "entity.name.function.macro",
        "entity.name.command",
        "support.function.magic",
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "meta.annotation",
        "storage.type.annotation",
        "punctuation.definition.annotation",
        "entity.other.pseudo-class",
        "entity.other.pseudo-element",
        "entity.name.function.preprocessor",
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#306770"
      }
    },
    {
      "name": "Types, classes, interfaces, primitives, lifetimes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.interface",
        "entity.name.trait",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "support.class.component",
        "storage.type.primitive",
        "storage.type.built-in",
        "storage.type.core",
        "storage.type.numeric",
        "storage.type.string.go",
        "storage.type.boolean",
        "storage.type.byte",
        "storage.type.rune",
        "storage.type.error",
        "storage.type.generic",
        "storage.modifier.lifetime",
        "entity.name.lifetime",
        "entity.name.type.anchor",
        "entity.other.attribute-name",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "markup.fenced_code.block.markdown fenced_code.block.language"
      ],
      "settings": {
        "foreground": "#84533D"
      }
    },
    {
      "name": "Namespaces, modules and properties stay neutral",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.package",
        "support.type.property-name",
        "support.type.vendored.property-name",
        "variable.css",
        "variable.argument.css"
      ],
      "settings": {
        "foreground": "#28313B"
      }
    },
    {
      "name": "Structured data keys",
      "scope": [
        "support.type.property-name.json",
        "support.type.property-name.toml",
        "entity.name.tag.yaml",
        "support.type.property-name.yaml"
      ],
      "settings": {
        "foreground": "#285D85"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "markup.heading entity.name",
        "punctuation.definition.heading",
        "markdown.heading",
        "beginning.punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#285D85",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.bold",
        "punctuation.definition.bold"
      ],
      "settings": {
        "foreground": "#28313B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic",
        "punctuation.definition.italic"
      ],
      "settings": {
        "foreground": "#28313B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown strikethrough",
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "foreground": "#465463",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "string.other.link.title",
        "string.other.link.description",
        "markup.underline.link.image"
      ],
      "settings": {
        "foreground": "#285D85"
      }
    },
    {
      "name": "Markdown URLs",
      "scope": [
        "markup.underline.link",
        "string.other.link.destination"
      ],
      "settings": {
        "foreground": "#536273"
      }
    },
    {
      "name": "Markdown list markers",
      "scope": [
        "punctuation.definition.list.begin",
        "beginning.punctuation.definition.list",
        "markup.list punctuation.definition"
      ],
      "settings": {
        "foreground": "#285D85"
      }
    },
    {
      "name": "Markdown quotes and rules",
      "scope": [
        "markup.quote",
        "punctuation.definition.quote",
        "meta.separator"
      ],
      "settings": {
        "foreground": "#465463"
      }
    },
    {
      "name": "Diff",
      "scope": [
        "markup.inserted",
        "punctuation.definition.inserted",
        "meta.diff.header.to-file",
        "punctuation.definition.to-file.diff"
      ],
      "settings": {
        "foreground": "#32664D"
      }
    },
    {
      "name": "Diff removed",
      "scope": [
        "markup.deleted",
        "punctuation.definition.deleted",
        "meta.diff.header.from-file",
        "punctuation.definition.from-file.diff"
      ],
      "settings": {
        "foreground": "#A43F4A"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": {
        "foreground": "#765319"
      }
    },
    {
      "name": "Diff hunks and headers",
      "scope": [
        "meta.diff.range",
        "meta.diff.index",
        "meta.diff.header.git"
      ],
      "settings": {
        "foreground": "#306770"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#A43F4A",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated",
        "markup.strikethrough.deprecated"
      ],
      "settings": {
        "foreground": "#536273",
        "fontStyle": "strikethrough"
      }
    }
  ],
